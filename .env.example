# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun. .env.local git'e gönderilmez.
# Vercel'de aynı değişkenleri Project → Settings → Environment Variables altına ekleyin.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://uqcibwzldhlpougclgjw.supabase.co

# Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...) ya da eski "service_role" anahtarı.
# GİZLİDİR: Kimseyle paylaşmayın, NEXT_PUBLIC_ ile başlayan bir değişkene koymayın.
SUPABASE_SECRET_KEY=

# İsteğe bağlı: canlı site adresi (sitemap ve paylaşım linkleri için)
# NEXT_PUBLIC_SITE_URL=https://bukimade.com
